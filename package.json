{
  "name": "opencode-transatlantic",
  "version": "0.2.3",
  "description": "soft cross-session chat for opencode v2 — queue-only, never interrupts",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist-tui/transatlantic.js"
  },
  "files": [
    "src",
    "dist-tui",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mintygingy/opencode-transatlantic.git"
  },
  "homepage": "https://github.com/mintygingy/opencode-transatlantic",
  "bugs": "https://github.com/mintygingy/opencode-transatlantic/issues",
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist-plugin/transatlantic.js",
    "build:tui": "esbuild src/tui.tsx --bundle --platform=node --format=esm --jsx=automatic --jsx-import-source=solid-js/h --jsx-dev=false --external:@opencode/plugin/tui --external:opencode-transatlantic --outfile=dist-tui/transatlantic.js"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "solid-js": "^1.9.12",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
